# ---------------------------------------------------------------------------
# Credenciais do PostgreSQL lidas pelo docker-compose.yml
# Copie este arquivo para .env (na raiz) antes de subir o banco.
#   Linux/macOS:  cp .env.example .env
#   Windows:      Copy-Item .env.example .env
#
# Estes valores são de DESENVOLVIMENTO LOCAL. Nunca use em produção.
# Se mudar qualquer um deles, atualize também a DATABASE_URL em apps/api/.env
# ---------------------------------------------------------------------------

POSTGRES_USER=studyflow
POSTGRES_PASSWORD=studyflow_dev_password
POSTGRES_DB=studyflow
POSTGRES_PORT=5432
