# ---------------------------------------------------------------------------
# Configuração da API do Study Flow.
# Copie para apps/api/.env antes de rodar:
#   Linux/macOS:  cp apps/api/.env.example apps/api/.env
#   Windows:      Copy-Item apps\api\.env.example apps\api\.env
# ---------------------------------------------------------------------------

NODE_ENV=development

# Porta da API.
PORT=3333

# IMPORTANTE: mantenha 0.0.0.0. Com 127.0.0.1 a API só aceita conexões da
# própria máquina e o celular com Expo Go nunca consegue alcançá-la.
HOST=0.0.0.0

# Conexão com o PostgreSQL do docker-compose.
# Se você mudou algo no .env da raiz, reflita a mudança aqui.
DATABASE_URL="postgresql://studyflow:studyflow_dev_password@localhost:5432/studyflow?schema=public"

# Segredo de assinatura dos tokens JWT. Mínimo de 32 caracteres.
# Gere o seu (funciona igual em Linux, macOS e Windows):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA versione o valor real e NUNCA reaproveite este exemplo.
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-de-32-caracteres

# Validade do token de acesso (formato aceito pela lib jsonwebtoken).
JWT_EXPIRES_IN=7d

# Origens liberadas no CORS. Use "*" em desenvolvimento;
# em produção liste as origens separadas por vírgula.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Seed de demonstração (npm run db:seed).
# Só é lido por prisma/seed.ts; a API em si não usa estas variáveis.
# Valores ILUSTRATIVOS: troque antes de rodar e nunca versione o valor real.
# ---------------------------------------------------------------------------
SEED_EMAIL=estudante@exemplo.com
SEED_PASSWORD=Exemplo-Trocar-123

# ---------------------------------------------------------------------------
# Gemini (assistente de plano de estudos)
# 1. Acesse https://aistudio.google.com/app/apikey e clique em "Create API key".
# 2. Cole a chave abaixo (sem aspas). NUNCA versione a chave real.
# Sem a chave a API funciona normalmente; só o assistente responde 503.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Modelo usado. "gemini-flash-lite-latest" é rápido e o mais estável no plano gratuito.
# Rode "npm run gemini:check" para ver qual modelo responde melhor para a sua chave.
GEMINI_MODEL=gemini-flash-lite-latest

# Quanto o Gemini "pensa" antes de responder: minimal | low | medium | high | default.
# "low" deixa as respostas rápidas (recomendado). Valores altos podem passar de 1 minuto.
GEMINI_THINKING_LEVEL=low

# Modelos reserva (separados por vírgula) usados quando o principal estiver
# sobrecarregado ou sem cota. Cada modelo tem sua própria cota no plano gratuito.
GEMINI_FALLBACK_MODELS=gemini-flash-latest

# Tempo máximo de UMA tentativa e prazo total da mensagem (com novas tentativas), em segundos.
GEMINI_TIMEOUT_SECONDS=60
GEMINI_TOTAL_TIMEOUT_SECONDS=150
